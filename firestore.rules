rules_version = '2';

// Access model
// - Admins (listed in isAdmin) can always read/write and approve family members.
// - Anyone else signs in with Google, which creates a pending request in /members/{uid}.
//   An admin approves it in the app (Coach guide → Family access). Approved members can train and log.
// Keep ADMIN_EMAILS in public/js/access.js in sync with the list below.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.email.lower() in [
        'henrysastrak@gmail.com'
      ];
    }
    function memberDoc() {
      return /databases/$(database)/documents/members/$(request.auth.uid);
    }
    function isMember() {
      return signedIn() && exists(memberDoc()) && get(memberDoc()).data.approved == true;
    }
    function allowed() {
      return isAdmin() || isMember();
    }

    function validLog(id) {
      let d = request.resource.data;
      return d.player in ['harvell', 'jasper']
        && d.date is string
        && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && id == d.player + '_' + d.date
        && d.mode in ['full', 'lite']
        && d.blocks is map
        && d.complete is bool
        && d.keys().hasOnly(['player', 'date', 'mode', 'blocks', 'score', 'tests', 'complete', 'updatedAt', 'updatedBy']);
    }

    // Family members: one doc per Google account (uid).
    match /members/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      // a new account may only file its own pending request
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.approved == false
        && request.resource.data.player == null
        && request.resource.data.keys().hasOnly(['email', 'name', 'approved', 'player', 'requestedAt']);
      allow update, delete: if isAdmin();
    }

    // One document per player per day: logs/{player}_{yyyy-mm-dd}
    match /logs/{id} {
      allow read: if allowed();
      allow create, update: if allowed() && validLog(id);
      allow delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
